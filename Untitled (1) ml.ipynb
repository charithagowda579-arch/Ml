 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a1c3c70-ee11-4ab9-95b3-b804aca3a521",
   "metadata": {},
   "outputs": [],
   "source": [
    "# This Python 3 environment comes with many helpful analytics libraries installed\n",
    "# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n",
    "\n",
    "import numpy as np # linear algebra\n",
    "import pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import tensorflow as tf\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "from imblearn.over_sampling import SMOTE\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, Dropout"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dfde3bf2-0c30-468f-850b-a0c9ddf7a8c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the dataset\n",
    "df = pd.read_csv(\"creditcard.csv\")\n",
    "print(f\"Dataset Shape: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0ff4c437-553e-48ef-a1d0-d8b766d1579b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check dataset info\n",
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4cc333a9-a023-4016-8946-9872099048e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Statistical summary\n",
    "df.describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "22073c40-c7ff-4d6b-9d44-96a6fee275a9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze target column (class imbalance)\n",
    "target_col = df.columns[-1]\n",
    "print(f\"Class Distribution:\")\n",
    "print(df[target_col].value_counts())\n",
    "fraud_percentage = len(df[df[target_col] == 1]) / len(df[target_col]) * 100\n",
    "print(f\"Fraud Percentage: {fraud_percentage:.4f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fe7bd073-8307-4e13-8cd8-0bfaeaf36522",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot correlation heatmap\n",
    "plt.figure(figsize=(16,10))\n",
    "plt.title('Correlation Analysis', size=15)\n",
    "sns.heatmap(df.corr(), fmt='.1f', annot=True, cmap='coolwarm')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Separate features and target\n",
    "target_col = df.columns[-1]\n",
    "x = df.drop(target_col, axis=1)\n",
    "y = df[target_col]\n",
    "col_names = list(x.columns)\n",
    "print(f\"Features: {col_names}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "56968c27-1dec-46b7-b661-0cbacd0e52f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Scale features using StandardScaler\n",
    "scaler = StandardScaler()\n",
    "x_scaled = scaler.fit_transform(x)\n",
    "x = pd.DataFrame(x_scaled, columns=col_names)\n",
    "print(\"Scaled data statistics:\")\n",
    "x.describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ca2566ee-37b9-4e0c-b75f-c5164eda96e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train-test split with stratification\n",
    "x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.25, random_state=42, stratify=y)\n",
    "print(f\"Train set size: {x_train.shape[0]}\")\n",
    "print(f\"Test set size: {x_test.shape[0]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "170a0aa7-8ed0-46ab-a209-986d49bbf6d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply SMOTE for class imbalance\n",
    "print(\"Applying SMOTE to balance training data...\")\n",
    "smote = SMOTE(random_state=42, k_neighbors=5)\n",
    "x_train_smote, y_train_smote = smote.fit_resample(x_train, y_train)\n",
    "\n",
    "print(f\"After SMOTE:\")\n",
    "print(f\"Training set size: {x_train_smote.shape[0]}\")\n",
    "print(f\"Class distribution:\\n{pd.Series(y_train_smote).value_counts()}\")\n",
    "\n",
    "# Visualize balanced data\n",
    "plt.figure(figsize=(10, 4))\n",
    "pd.Series(y_train_smote).value_counts().plot(kind=\"bar\")\n",
    "plt.title(\"SMOTE Balanced Training Data\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eb055aa2-ac8b-4162-8d6f-83322da1f8bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Random Forest Model\n",
    "print(\"Training Random Forest Model...\")\n",
    "rf_model = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n",
    "rf_model.fit(x_train_smote, y_train_smote)\n",
    "\n",
    "rf_train_score = rf_model.score(x_train_smote, y_train_smote)\n",
    "rf_test_score = rf_model.score(x_test, y_test)\n",
    "print(f\"Random Forest - Train Accuracy: {rf_train_score:.4f}\")\n",
    "print(f\"Random Forest - Test Accuracy: {rf_test_score:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5197cecc-5222-48cf-b4be-5d7e3a27cfe5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build Neural Network\n",
    "print(\"Building Neural Network...\")\n",
    "model = Sequential([\n",
    "    Dense(input_dim=30, units=128, activation=\"relu\"),\n",
    "    Dropout(0.3),\n",
    "    Dense(units=64, activation=\"relu\"),\n",
    "    Dropout(0.25),\n",
    "    Dense(units=32, activation=\"relu\"),\n",
    "    Dropout(0.25),\n",
    "    Dense(units=16, activation=\"relu\"),\n",
    "    Dropout(0.2),\n",
    "    Dense(units=1, activation=\"sigmoid\")\n",
    "])\n",
    "\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "878cb3bf-01f4-4fca-8437-7cb0b1967ae3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compile and train model\n",
    "model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])\n",
    "\n",
    "history = model.fit(\n",
    "    x_train_smote, y_train_smote,\n",
    "    epochs=15,\n",
    "    batch_size=32,\n",
    "    validation_data=(x_test, y_test),\n",
    "    verbose=1\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "463b72ac-ea32-438e-a52d-bf6ed21d4a26",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot training history\n",
    "plt.figure(figsize=(14, 5))\n",
    "\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.plot(history.history['loss'], label='Training Loss')\n",
    "plt.plot(history.history['val_loss'], label='Validation Loss')\n",
    "plt.title('Model Loss')\n",
    "plt.xlabel('Epoch')\n",
    "plt.ylabel('Loss')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.plot(history.history['accuracy'], label='Training Accuracy')\n",
    "plt.plot(history.history['val_accuracy'], label='Validation Accuracy')\n",
    "plt.title('Model Accuracy')\n",
    "plt.xlabel('Epoch')\n",
    "plt.ylabel('Accuracy')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a9b570bd-763b-4d9c-8f09-a4b02c9d1d65",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make predictions and evaluate\n",
    "test_loss, test_accuracy = model.evaluate(x_test, y_test, verbose=0)\n",
    "print(f\"Neural Network - Test Accuracy: {test_accuracy:.4f}\")\n",
    "\n",
    "y_pred_proba = model.predict(x_test, verbose=0)\n",
    "y_pred_binary = (y_pred_proba > 0.5).astype(int).flatten()\n",
    "\n",
    "print(\"\\nClassification Report:\\n\")\n",
    "print(classification_report(y_test, y_pred_binary))\n",
    "\n",
    "print(\"\\nConfusion Matrix:\")\n",
    "print(confusion_matrix(y_test, y_pred_binary))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "92a22592-3451-4c50-9b86-063d6f7b80fb",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n" + \"="*60)\n",
    "print(\"MODEL COMPARISON SUMMARY\")\n",
    "print(\"="*60)\n",
    "print(f\"\\nRandom Forest Test Accuracy: {rf_test_score*100:.2f}%\")\n",
    "print(f\"Neural Network Test Accuracy: {test_accuracy*100:.2f}%\")\n",
    "print(\"\\n" + \"="*60)"
   ]
  }
 ],
